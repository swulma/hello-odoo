
<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- List View -->
    <record id="view_hello_note_list" model="ir.ui.view">
        <field name="name">hello.odoo.note.list</field>
        <field name="model">hello.odoo.note</field>
        <field name="arch" type="xml">
            <list>
                <field name="title"/>
                <field name="date"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hello_note_form" model="ir.ui.view">
        <field name="name">hello.odoo.note.form</field>
        <field name="model">hello.odoo.note</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="title"/>
                        <field name="date"/>
                        <field name="content"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_hello_notes" model="ir.actions.act_window">
        <field name="name">My Notes</field>
        <field name="res_model">hello.odoo.note</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Main Menu -->
    <menuitem
        id="menu_hello_odoo_root"
        name="Hello Odoo"
        sequence="10"
    />

    <!-- Notes Menu -->
    <menuitem
        id="menu_hello_notes"
        name="Notes"
        parent="menu_hello_odoo_root"
        action="action_hello_notes"
        sequence="10"
    />

</odoo>
